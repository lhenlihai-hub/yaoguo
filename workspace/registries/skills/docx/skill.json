{
  "id": "skill://docx@1",
  "kind": "skill",
  "trust": "bundled",
  "version": 1,
  "title": "Word 文档",
  "format": "docx",
  "entry": {
    "create": {
      "description": "把 Markdown 正文排版为 Word .docx 文件。",
      "runtime": "node",
      "script": "scripts/create.js",
      "sideEffects": "workspace_write",
      "idempotent": true,
      "timeoutMs": 120000,
      "pathParams": { "read": [], "write": ["outputPath"] },
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "properties": { "markdown": { "type": "string", "minLength": 1 } },
            "required": ["markdown"],
            "additionalProperties": false
          },
          "outputPath": { "type": "string", "minLength": 1 },
          "options": {
            "type": "object",
            "properties": {
              "pageSize": { "type": "string", "enum": ["letter", "a4"] },
              "orientation": { "type": "string", "enum": ["portrait", "landscape"] },
              "fontFamily": { "type": "string" },
              "fontSize": { "type": "number", "minimum": 6, "maximum": 72 },
              "margins": { "type": "object", "additionalProperties": true },
              "headings": { "type": "string", "enum": ["auto", "none"] },
              "tableOfContents": { "type": "boolean" },
              "header": {},
              "footer": {},
              "title": {},
              "author": {}
            },
            "additionalProperties": false
          }
        },
        "required": ["source", "outputPath"],
        "additionalProperties": false
      }
    },
    "read": {
      "description": "读取 Word .docx 并返回 Markdown 与结构摘要。",
      "runtime": "node",
      "script": "scripts/read.js",
      "sideEffects": "none",
      "idempotent": true,
      "timeoutMs": 60000,
      "pathParams": { "read": ["inputPath"], "write": [] },
      "inputSchema": {
        "type": "object",
        "properties": { "inputPath": { "type": "string", "minLength": 1 } },
        "required": ["inputPath"],
        "additionalProperties": false
      }
    },
    "validate": {
      "description": "检查 Word .docx 是否可解析，并拒绝包含内部工具协议的文件。",
      "runtime": "node",
      "script": "scripts/validate.js",
      "sideEffects": "none",
      "idempotent": true,
      "timeoutMs": 60000,
      "pathParams": { "read": ["inputPath"], "write": [] },
      "inputSchema": {
        "type": "object",
        "properties": { "inputPath": { "type": "string", "minLength": 1 } },
        "required": ["inputPath"],
        "additionalProperties": false
      }
    },
    "preview": {
      "description": "把 Word 渲染为 PDF；缺 LibreOffice 时生成近似 HTML 预览。",
      "runtime": "node",
      "script": "scripts/preview.js",
      "sideEffects": "workspace_write",
      "idempotent": true,
      "timeoutMs": 120000,
      "pathParams": { "read": ["inputPath"], "write": ["outputDir"] },
      "inputSchema": {
        "type": "object",
        "properties": {
          "inputPath": { "type": "string", "minLength": 1 },
          "outputDir": { "type": "string", "minLength": 1 },
          "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 }
        },
        "required": ["inputPath", "outputDir"],
        "additionalProperties": false
      }
    }
  },
  "dependencies": [
    { "id": "docx", "kind": "npm", "version": "^9.0.0", "required": true, "for": ["create"] },
    { "id": "marked", "kind": "npm", "version": "^14.0.0", "required": true, "for": ["create"] },
    { "id": "mammoth", "kind": "npm", "version": "^1.8.0", "required": true, "for": ["read", "validate", "preview"] },
    {
      "id": "libreoffice",
      "kind": "binary",
      "required": false,
      "for": ["preview"],
      "purpose": "高保真 PDF 预览；缺失时自动降级为 HTML。",
      "missingHint": "未安装 LibreOffice：预览会降级为近似 HTML，其他动作不受影响。"
    }
  ],
  "triggers": {
    "intents": ["导出 word", "生成 docx", "读取 word", "校验 word", "预览 word", "export word"],
    "extensions": [".docx", ".doc"],
    "outputFormats": ["docx"]
  },
  "outputContract": {
    "create": { "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "extension": "docx" },
    "read": { "mimeType": "text/markdown", "structure": ["headings", "tables", "images"] },
    "preview": {
      "backends": [
        { "id": "libreoffice", "mimeType": "application/pdf", "result": "pdfPath", "fidelity": "exact" },
        { "id": "mammoth", "mimeType": "text/html", "result": "htmlPath", "fidelity": "approximate" }
      ]
    }
  },
  "safety": { "networkAccess": false, "fileWrite": "scoped", "requiresUserConfirm": false },
  "exposure": { "mode": "orchestrated", "tool": "generate_document" },
  "instructionsRef": "SKILL.md"
}
